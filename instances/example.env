# Plantilla de instancia. Copiala a instances/<usuario>.env (NO se commitea) y
# arrancala con:  scripts\start_all.ps1
# (o dala de alta con:  python -m scripts.provision alta ...  que escribe este
#  archivo por ti y clona el terminal MT5).
#
# UN FICHERO POR USUARIO, no por motor.
# Una instancia = un usuario = una cuenta MT5 = un terminal MT5. Sobre esa misma
# cuenta pueden correr varios motores del bot nuevo (n1, n2...): comparten
# credenciales y solo difieren en BOT_ID y MAGIC_NUMBER, que los inyecta
# scripts\run_motor.ps1 desde el registro de motores (motor\engines.json).

# --- Supabase (igual para todas las instancias del proyecto) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# --- Identidad de ESTE usuario ---
# Usa un usuario de Supabase NUEVO, nunca uno que ya tenga filas de produccion
# (e2/m15/m5).
USER_ID=<uuid_del_usuario_en_auth.users>
SYMBOL=XAUUSD+

# --- Motores a levantar sobre esta cuenta ---
# Uno o varios de motor\engines.json, separados por coma. Hoy: n1 y n2 (nulos).
BOTS=n1,n2

# Magics de la cuenta. Deben ser DISTINTOS entre si y distintos de los de
# produccion (MAGIC_M15 / MAGIC_M5 / MAGIC_E2). Si no los pones, se usan los
# del registro (300100 y 300200).
MAGIC_N1=300100
MAGIC_N2=300200

# --- Terminal MetaTrader 5 de la cuenta (clon portable en MT5_CLONES_DIR) ---
MT5_PATH=C:\MT5_instances_n1\mt5_12345678\terminal64.exe
MT5_LOGIN=12345678
MT5_SERVER=<servidor_del_broker>
MT5_PASSWORD=<password_de_la_cuenta>
MT5_PORTABLE=true
# Carpeta de clones del bot nuevo. NUNCA C:\MT5_instances (es la de produccion).
MT5_CLONES_DIR=C:\MT5_instances_n1

# --- Noticias (NewsGuard) ---
# El bot nuevo NO lanza su propio exportador: lee el JSON que ya escribe el
# de produccion. Por defecto: %APPDATA%\MetaQuotes\Terminal\Common\Files\news_calendar.json
# NEWS_CALENDAR_PATH=

# --- Resend (opcional; notificaciones por correo, ver motor/notify.py) ---
# Sin RESEND_API_KEY no se envian correos (el evento igual queda en la DB).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM=Sentinel <alertas@tu-dominio.com>
# URL del dashboard para el boton del correo (default: produccion en Vercel).
# DASHBOARD_URL=https://sentinel-trading-webapp.vercel.app/

# --- Opcional ---
# Postgres local del bot nuevo (vacio = desactivado; el bot arranca igual con un aviso).
# Guia: docs/como-funciona.md, "Postgres local: preparacion".
# LOCAL_PG_DSN=postgresql://sentinel_n1:<password>@localhost:5432/sentinel_n1
# Modo sombra: los motores deciden y loguean, pero NO envian ordenes al broker.
# Recomendado en la primera vuelta de una cuenta nueva.
# SHADOW_MODE=true
